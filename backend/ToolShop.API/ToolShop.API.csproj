    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolShop.Domain\ToolShop.Domain.csproj" />
