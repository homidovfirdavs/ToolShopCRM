# Copy to deploy/.env  (or run ./init-env.sh which fills the blanks with random values).
# deploy/.env is git-ignored. NEVER commit real values. Use letters/digits only in passwords (they go into a connection string).

# --- public address -----------------------------------------------------------
PUBLIC_ORIGIN=https://crm.example.com
HTTP_PORT=80
HTTPS_PORT=443
# staging on one machine:  HTTP_PORT=8080  HTTPS_PORT=8443  PUBLIC_ORIGIN=https://localhost:8443  HSTS_MAX_AGE=0
HSTS_MAX_AGE=31536000

# --- database -----------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
DB_NAME=toolshop_crm
DB_OWNER=toolshop_owner
DB_OWNER_PASSWORD=
APP_DB_USER=toolshop_app
APP_DB_PASSWORD=

# --- API ----------------------------------------------------------------------
JWT_KEY=
JWT_ISSUER=toolshop-crm
JWT_AUDIENCE=toolshop-crm-users

# first-run admin (only used if this user does not exist yet; leave blank to skip)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- backups ------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
APP_BUILD_ID=
